generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]
}

enum ProductKind {
  deal
  secondhand
}

model Product {
  id            Int         @id @default(autoincrement())
  kind          ProductKind
  title         String
  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])
  price         Int
  discountPercent Float     @default(0)
  stock         Int         @default(1)
  imageUrl      String?
  imageUrls     String[]    @default([])
  shortNote     String?
  storeArea     String?
  shopName      String?
  affiliateLink String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  clicks        Click[]
  cartItems     CartItem[]
  flashSaleItems FlashSaleItem[]
}

model Click {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  clickedAt DateTime @default(now())
}

model Setting {
  id                Int     @id
  whatsappNumber    String
  whatsappTemplate  String  @default("Halo, saya tertarik dengan produk ini.")
  siteName          String
  contactEmail      String?
  shopeeAffiliateId String? // used by admin optional an_redir link helper
}

/** Singleton flash sale config + timed product picks (secondhand only). */
model FlashSale {
  id               Int             @id @default(1)
  isActive         Boolean         @default(false)
  durationMinutes  Int             @default(60)
  startedAt        DateTime?
  endsAt           DateTime?
  items            FlashSaleItem[]
  updatedAt        DateTime        @updatedAt
}

model FlashSaleItem {
  id          Int       @id @default(autoincrement())
  flashSaleId Int       @default(1)
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)

  @@unique([flashSaleId, productId])
  @@index([flashSaleId, sortOrder])
}

enum UserRole {
  visitor
  admin
}

/** Google-authenticated users (visitors + admins). */
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  role      UserRole   @default(visitor)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
}

/** Emails allowed to access /admin after Google login. */
model AdminAllowlist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

