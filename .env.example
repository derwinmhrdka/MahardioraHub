DATABASE_URL=postgresql://dealhub:dealhub@db:5432/dealhub
# Host port mapped to the app (avoids conflict with other apps on 3000/3001)
APP_HOST_PORT=13000
# Optional: used by deploy script / WhatsApp product links (fallback: mahardiora-hub.teknodika.com)
DOMAIN=mahardiora-hub.teknodika.com
NODE_ENV=production

# Auth.js
AUTH_SECRET=generate-a-long-random-string
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:13000

# Google OAuth — required in production only.
# In development (NODE_ENV !== production), /login skips Google and
# offers Visitor / Admin buttons instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Xendit (test/live secret key from Dashboard → API Keys)
# Webhook URL: https://YOUR_DOMAIN/api/xendit/webhook
# Verification token: Dashboard → Settings → Callbacks → Callback verification token
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
