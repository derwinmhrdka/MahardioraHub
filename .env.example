DATABASE_URL=postgresql://dealhub:dealhub@db:5432/dealhub
# Host port mapped to the app (avoids conflict with other apps on 3000/3001)
APP_HOST_PORT=13000
# Optional: used by deploy script / WhatsApp product links (fallback: mahardiora-hub.teknodika.com)
DOMAIN=mahardiora-hub.teknodika.com
NODE_ENV=production

# Auth.js / Google OAuth
AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: AUTH_URL=https://mahardiora-hub.teknodika.com
