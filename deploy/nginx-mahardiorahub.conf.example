# Host nginx — HTTPS for mahardiora-hub.teknodika.com
# Docker app listens on 127.0.0.1:13000 only (does not use host 3000/3001).
#
# Setup on VPS (once):
#   1. DNS: mahardiora-hub.teknodika.com → VPS IP
#   2. sudo cp deploy/nginx-mahardiorahub.conf.example /etc/nginx/sites-available/mahardiorahub
#   3. Edit proxy_pass if you changed APP_HOST_PORT
#   4. sudo ln -s /etc/nginx/sites-available/mahardiorahub /etc/nginx/sites-enabled/
#   5. sudo nginx -t && sudo systemctl reload nginx
#   6. sudo certbot --nginx -d mahardiora-hub.teknodika.com
#
# Deploy app: bash deploy/docker-deploy.sh

server {
    listen 80;
    server_name mahardiora-hub.teknodika.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name mahardiora-hub.teknodika.com;

    # certbot adds ssl_certificate / ssl_certificate_key here

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
